{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WPInternals Rust",
  "version": "0.1.0",
  "identifier": "org.wpinternals.rust",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node ../scripts/build-ui.mjs",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [{ "title": "WPInternals Rust", "width": 1240, "height": 820, "minWidth": 800, "minHeight": 620 }],
    "security": { "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"], "shortDescription": "Local Lumia device and firmware tools" }
}
